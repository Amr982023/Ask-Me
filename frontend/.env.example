# IMPORTANT: set this to YOUR backend's actual URL - it is NOT always
# http://localhost:5000. ASP.NET Core projects (especially created via
# Visual Studio) usually get a random HTTPS port assigned per machine.
# Find yours in src/AskMe.API/Properties/launchSettings.json under
# "applicationUrl", or read it from the console when you run the API.
VITE_API_BASE_URL=https://localhost:5001/api

VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
